# =============================================================================
# BEL Backend — Environment Variables
# Copy this file to .env and fill in the values. NEVER commit .env to git.
# =============================================================================

# --- AI Providers --------------------------------------------------------
# Company internal LLM (tried FIRST when configured). Leave blank to skip.
# Assumes OpenAI-compatible endpoint (vLLM, LiteLLM, Bedrock proxy, private
# GPT/Claude gateway, etc.). If your company's LLM has a custom JSON shape,
# swap the OpenAI client in services/ai_service.py for httpx.
COMPANY_LLM_BASE_URL=
COMPANY_LLM_API_KEY=
COMPANY_LLM_MODEL=

# OpenRouter keys (tried in order on rate-limit / auth errors).
# Provide at least one. Get keys at https://openrouter.ai/
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# Groq (fallback). Get a key at https://console.groq.com/
GROQ_API_KEY=

# Fallback order. Comma-separated; first one tried first. Providers that
# fail (401 / 402 / not-configured) are marked dead for the process and
# skipped on subsequent calls — no retry storms.
AI_FALLBACK_ORDER=company,openrouter,groq

# Testing flag — set to true to invoke the LLM on EVERY analytical query,
# regardless of classifier confidence. Useful for verifying the LLM path is
# wired end-to-end. Leave commented out for production.
# FORCE_LLM_ALWAYS=true

# --- Server --------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO

# Comma-separated allowed origins. RESTRICT in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File uploads --------------------------------------------------------
UPLOAD_DIR=uploads
# Upload cap in MB. Bump higher for very large enterprise datasets.
MAX_UPLOAD_SIZE_MB=500
